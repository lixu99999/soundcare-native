{
  "name": "SoundCare",
  "appid": "__UNI__SOUNDCARE_NATIVE",
  "description": "SoundCare HRV Native APP (Phase 1B/2 manifest — has SoundCareHRV plugin)",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "nativePlugins": {
      "SoundCareHRV": {
        "version": "1.0.0"
      }
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "ios": {}
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {}
  },
  "h5": {
    "router": {
      "mode": "hash",
      "base": "./"
    },
    "title": "SoundCare"
  }
}
